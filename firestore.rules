rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Products collection: public read for students and staff, write for staff catalog management
    match /products/{productId} {
      allow read: if true;
      allow write: if true;
    }

    // Orders collection: read for live tracking and Kanban board, create for checkout, update for status progression
    match /orders/{orderId} {
      allow read: if true;
      allow create: if true;
      allow update: if true;
      allow delete: if false;
    }
  }
}
